# ==============================================================================
# tripCircle Monorepo Environment Configuration (.env.example)
# ==============================================================================

# API Configuration
API_PORT=3000
NODE_ENV=development

# MySQL Database
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=tripcircle
MYSQL_USER=tripcircle
MYSQL_PASSWORD=tripcircle_pass
MYSQL_PORT=3306
DATABASE_URL="mysql://tripcircle:tripcircle_pass@localhost:3306/tripcircle"

# Auth Tokens
JWT_ACCESS_SECRET="generate-a-strong-256-bit-access-secret-for-production"
JWT_REFRESH_SECRET="generate-a-strong-256-bit-refresh-secret-for-production"

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="tripCircle"
SMTP_FROM_EMAIL=

# Cloudflare R2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tripcircle-assets
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# Mobile Expo Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
