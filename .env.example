# ==============================================================================
# tripCircle Monorepo Environment Configuration (Example)
# Copy to .env or individual app .env files for local development.
# ==============================================================================

# Database (MySQL 8.0)
DATABASE_URL="mysql://tripcircle:tripcircle_pass@localhost:3306/tripcircle"
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_NAME="tripcircle"
DATABASE_USER="tripcircle"
DATABASE_PASSWORD="tripcircle_pass"

# API Server
NODE_ENV="development"
PORT="3000"
API_BASE_URL="http://localhost:3000"
CORS_ORIGIN="*"

# Authentication & JWT Secrets (Replace with random 256-bit keys in production)
JWT_ACCESS_SECRET="dev-jwt-access-secret-tripcircle-32chars-minimum-key"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-tripcircle-32chars-minimum-key"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Email / SMTP (for OTP Verification & Password Recovery)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="smtp-username-placeholder"
SMTP_PASS="smtp-password-placeholder"
SMTP_FROM="noreply@tripcircle.app"
SMTP_SECURE="false"

# File Storage (Local disk or S3 compatible object storage)
STORAGE_DRIVER="local" # 'local' or 's3'
LOCAL_UPLOAD_DIR="./uploads"

# S3 Compatible Object Storage (MinIO / AWS S3 / Cloudflare R2)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="tripcircle-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Push Notifications (Firebase Cloud Messaging / Expo Push)
EXPO_ACCESS_TOKEN=""
FCM_SERVER_KEY=""

# Mobile Client Environment
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"
EXPO_PUBLIC_APP_ENV="development"
