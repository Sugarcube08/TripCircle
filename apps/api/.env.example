# ==============================================================================
# tripCircle API Environment Configuration (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=3000

# Public API and mobile-facing links
API_BASE_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:8081

# Database Configuration (Remote MySQL or Local Docker)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict
DATABASE_URL="mysql://tripcircle:tripcircle_pass@localhost:3306/tripcircle"
DATABASE_CONNECTION_LIMIT=10

# Authentication & JWT Secrets (Use high-entropy 256-bit keys in production)
JWT_ACCESS_SECRET="generate-a-strong-256-bit-access-secret-for-production"
JWT_REFRESH_SECRET="generate-a-strong-256-bit-refresh-secret-for-production"

# Gmail SMTP Configuration
# Use smtp.gmail.com with port 587 (STARTTLS) or port 465 (implicit TLS)
# Use a 16-character Google Account App Password, NOT your regular Google password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="tripCircle"
SMTP_FROM_EMAIL=

# Cloudflare R2 Object Storage (S3-compatible API)
# Set STORAGE_DRIVER=r2 for production, or local for development without R2 credentials
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tripcircle-assets
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# File Upload Limits & MIME Constraints
FILE_MAX_SIZE_BYTES=10485760
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
