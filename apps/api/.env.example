# ==============================================================================
# TripCircle API Environment Configuration (.env.example)
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=3000

# Base URLs
API_BASE_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:8081

# Database Configuration (MySQL 8.0)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict
DATABASE_URL="mysql://tripcircle:tripcircle_pass@localhost:3306/tripcircle"
DATABASE_CONNECTION_LIMIT=10

# Authentication (HMAC SHA-256 JWT Secrets)
JWT_ACCESS_SECRET="generate-a-strong-256-bit-access-secret-for-production"
JWT_REFRESH_SECRET="generate-a-strong-256-bit-refresh-secret-for-production"

# Gmail SMTP Email Delivery
# Use 16-character Google Account App Password (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="TripCircle"
SMTP_FROM_EMAIL=

# Cloudflare R2 Object Storage (Set to 'r2' for production, 'local' for development)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tripcircle-assets

# Background Outbox Cron Authentication (Optional)
CRON_SECRET=
